{{!
    @template local_erasight/course

    The "Course Details" pre-purchase page. New, plugin-owned markup, not a
    core override. Deliberately does NOT show ratings, star reviews, or
    named student testimonials the way the design reference did — Moodle
    has no native subsystem backing any of those, and an admin manually
    typing in a "4.8 stars" figure would misrepresent it as real aggregated
    feedback. Only real (or real-and-admin-provided) data is rendered here.

    Context: id/fullname/category/summary/courseimage, price (object with
    a formatted string, or absent), enrolled (bool), viewurl/enrolurl/
    catalogurl, instructor (fullname/initials, or absent), curriculum
    (array of title/items, each item a name) plus a separate hascurriculum
    boolean and lessoncount, isnew (bool, from course creation date),
    hascertificate (bool, only true when the course contains a real
    certificate activity), accesstext (a real access-duration string, or
    absent when there's no price yet), and three optional admin-authored
    HTML blocks — learncontent, requirementscontent, faqcontent — sourced
    from real course custom fields (see
    local_erasight_get_course_customfields() in lib.php), each section
    omitted entirely when its field is left blank.

    NOTE: never write two closing-brace characters next to each other
    anywhere in this comment block — a Mustache comment ends at the first
    such occurrence it scans past, not a matched one, which is why this
    comment is prose rather than a literal JSON/tag example.

    NOTE: hascurriculum exists as a separate key from curriculum on
    purpose — a curriculum section tag repeats its block once PER SECTION,
    it is not an "if non-empty" guard. Using curriculum itself to wrap the
    "Course content" heading meant any course with more than one section
    duplicated that heading and the lesson-count stat once per section
    (the exact bug that also hit landing.mustache's testimonials section
    — same fix here: a real boolean for the guard, the array only for
    the loop).
}}
<div class="erasight-coursedetail">
    <div class="erasight-cd-hero" style='background-image: linear-gradient(180deg, rgba(36,23,8,.15), rgba(36,23,8,.75)), url("{{{courseimage}}}");'>
        <div class="erasight-cd-hero-inner">
            <div class="erasight-cd-crumb"><a href="{{catalogurl}}">{{#str}} catalog, local_erasight {{/str}}</a> / {{category}}</div>
            {{#category}}<span class="erasight-cd-cat">{{category}}</span>{{/category}}
            {{#isnew}}<span class="erasight-cd-badge erasight-cd-badge-new">{{#str}} newbadge, local_erasight {{/str}}</span>{{/isnew}}
            <h1>{{fullname}}</h1>
            {{#hascurriculum}}<div class="erasight-cd-stats"><span>{{lessoncount}} {{#str}} lessons, local_erasight {{/str}}</span></div>{{/hascurriculum}}
        </div>

        <div class="erasight-buy-card">
            <div class="erasight-buy-body">
                {{#price}}
                    <div class="erasight-buy-price">{{formatted}}</div>
                {{/price}}
                {{^price}}
                    <div class="erasight-buy-price erasight-buy-price-tbd">{{#str}} pricetbd, local_erasight {{/str}}</div>
                {{/price}}

                {{#enrolled}}
                    <a class="erasight-buy-btn" href="{{viewurl}}">{{#str}} gotocourse, local_erasight {{/str}}</a>
                {{/enrolled}}
                {{^enrolled}}
                    <a class="erasight-buy-btn" href="{{enrolurl}}">{{#str}} enrolnow, local_erasight {{/str}}</a>
                {{/enrolled}}
                <div class="erasight-buy-secure">{{#str}} securecheckout, local_erasight {{/str}}</div>

                <ul class="erasight-buy-includes">
                    {{#hascurriculum}}<li>{{lessoncount}} {{#str}} lessons, local_erasight {{/str}}</li>{{/hascurriculum}}
                    {{#accesstext}}<li>{{accesstext}}</li>{{/accesstext}}
                    {{#hascertificate}}<li>{{#str}} certificateofcompletion, local_erasight {{/str}}</li>{{/hascertificate}}
                </ul>
            </div>
        </div>
    </div>

    <div class="erasight-cd-body">
        <div class="erasight-cd-main">
            <h3>{{#str}} description, local_erasight {{/str}}</h3>
            <div class="erasight-cd-summary">{{{summary}}}</div>

            {{#hascurriculum}}
            <h3>{{#str}} coursecontent, local_erasight {{/str}}</h3>
            <div class="erasight-cd-curriculum">
                {{#curriculum}}
                <div class="erasight-cd-cusec">
                    <div class="erasight-cd-cuhead">{{title}}</div>
                    <div class="erasight-cd-culessons">
                        {{#items}}<div class="erasight-cd-cuitem">{{name}}</div>{{/items}}
                    </div>
                </div>
                {{/curriculum}}
            </div>
            {{/hascurriculum}}

            {{#learncontent}}
            <h3>{{#str}} whatyoulllearn, local_erasight {{/str}}</h3>
            <div class="erasight-cd-learn">{{{learncontent}}}</div>
            {{/learncontent}}

            {{#requirementscontent}}
            <h3>{{#str}} requirements, local_erasight {{/str}}</h3>
            <div class="erasight-cd-requirements">{{{requirementscontent}}}</div>
            {{/requirementscontent}}

            {{#faqcontent}}
            <h3>{{#str}} faq, local_erasight {{/str}}</h3>
            <div class="erasight-cd-faq">{{{faqcontent}}}</div>
            {{/faqcontent}}
        </div>

        {{#instructor}}
        <div class="erasight-cd-side">
            <h3>{{#str}} instructor, local_erasight {{/str}}</h3>
            <div class="erasight-cd-instructor">
                <div class="erasight-cd-avatar">{{initials}}</div>
                <div>{{fullname}}</div>
            </div>
        </div>
        {{/instructor}}
    </div>
</div>
