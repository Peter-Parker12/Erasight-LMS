{{!
    @template theme_erasight/frontpage

    A near-copy of theme_boost_union's real override of theme_boost/drawers
    (templates/theme_boost/drawers.mustache in
    moodle-an-hochschulen/moodle-theme_boost_union), fetched fresh on
    MOODLE_502_STABLE for this rebase — theme_erasight is now a Boost Union
    child theme, not a direct Boost child (see config.php). Boost Union's
    own override is substantially larger than raw Boost's (offcanvas
    drawers, extra block regions, smart menus, the slider/advertisement-tile
    frontpage extension points, a footnote partial, info banners) — kept
    verbatim here rather than trimmed, for the same reason layout/frontpage.php
    keeps all of Boost Union's real PHP logic: hand-retranscribing a large
    template risks silently dropping something, which is exactly the class
    of bug this rebuild exists to stop repeating.

    Two deliberate additions only: hidenavbar (bool, optional) suppresses
    both the persistent top nav bar and output.full_header (Moodle's own
    page-heading bar, redundant with this theme's own hero) — set only by
    layout/frontpage.php, so every other page keeps Boost Union's normal
    chrome; and herohtml/landinghtml, inserted just above output.main_content
    in the same position Boost Union's own "before" slider/tile hooks use,
    rendering as nothing when empty, not an error.

    NOTE: never write two closing-brace characters next to each other
    anywhere in this comment block, quoted or not — a Mustache comment ends
    at the first such occurrence it scans past, not a matched or nested
    one. This exact mistake broke this theme's entire front page live, more
    than once, in an earlier build — this comment stays prose for that
    reason, permanently, not just until it's inconvenient. The real Boost
    Union template this was forked from has its own "Example context
    (json)" block with literal braces; deliberately not carried over here.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{^hidenavbar}}{{> theme_boost/navbar }}{{/hidenavbar}}
    {{#courseindex}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-courseindex{{/id}}
            {{$drawerheadercontent}}
                {{> theme_boost/courseindexdrawercontrols}}
            {{/drawerheadercontent}}
            {{$drawerheading}}{{> theme_boost/courseindexdrawerheading}}{{/drawerheading}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}
                {{{courseindex}}}
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
            {{$closebuttonicon}}
                <span class="dir-rtl-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
            {{/closebuttonicon}}
        {{/ theme_boost/drawer}}
    {{/courseindex}}
    {{#hasblocks}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
            {{$closebuttonicon}}
                <span class="dir-rtl-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
            {{/closebuttonicon}}
        {{/ theme_boost/drawer}}
    {{/hasblocks}}

    {{^userisediting}}
        {{#regions.offcanvas.hasblocks}}
            {{< theme_boost/drawer }}
                {{$id}}theme_boost_union-drawers-offcanvas{{/id}}
                {{$drawerclasses}}drawer drawer-top{{/drawerclasses}}
                {{$drawercontent}}
                    {{> theme_boost_union/offcanvas}}
                {{/drawercontent}}
                {{$forceopen}}0{{/forceopen}}
                {{$drawerstate}}show-drawer-offcanvas{{/drawerstate}}
                {{$tooltipplacement}}top{{/tooltipplacement}}
                {{$drawercloseonresize}}1{{/drawercloseonresize}}
                {{$closebuttontext}}{{#str}}closeoffcanvas, theme_boost_union{{/str}}{{/closebuttontext}}
            {{/ theme_boost/drawer}}
        {{/regions.offcanvas.hasblocks}}
    {{/userisediting}}

    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        {{#userisediting}}
            <div id="theme-block-region-offcanvas-editing" class="collapse">
                <div id="theme-block-region-offcanvas-editing-inner">
                    {{> theme_boost_union/offcanvas}}
                </div>
            </div>
        {{/userisediting}}

        {{#regions.outsidetop.hasblocks}}
            <section id="theme-block-region-outside-top" class="theme-block-region {{{outsidetopwidth}}}" aria-label="{{#str}}blocks{{/str}}">
                {{{ regions.outsidetop.addblockbutton }}}
                {{{ regions.outsidetop.regionhtml }}}
            </section>
        {{/regions.outsidetop.hasblocks}}

        {{#regions.header.hasblocks}}
            <section id="theme-block-region-header" class="theme-block-region" aria-label="{{#str}}blocks{{/str}}">
                {{{ regions.header.addblockbutton }}}
                {{{ regions.header.regionhtml }}}
            </section>
        {{/regions.header.hasblocks}}
        {{{ herohtml }}}

        <div class="main-inner-wrapper {{{maininnerwrapperclass}}} {{{outsideregionsplacement}}}">
            {{#regions.outsideleft.hasblocks}}
                <section id="theme-block-region-outside-left" class="theme-block-region {{#blockregionsdata.outsideregions.verticaloffset}}invisible{{/blockregionsdata.outsideregions.verticaloffset}}" aria-label="{{#str}}blocks{{/str}}">
                    {{#blockregionsdata.outsideregions.verticaloffset}}<div class="outside-region-alignmentspacer"></div>{{/blockregionsdata.outsideregions.verticaloffset}}
                    {{{ regions.outsideleft.addblockbutton }}}
                    {{{ regions.outsideleft.regionhtml }}}
                 </section>
            {{/regions.outsideleft.hasblocks}}

        <div id="topofscroll" class="main-inner">
            {{^hidenavbar}}
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                    <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                        <button
                            class="btn btn-icon icon-size-3"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_boost-drawers-courseindex"
                            data-bs-toggle="tooltip"
                            data-bs-placement="right"
                            title="{{#str}}opendrawerindex, core{{/str}}"
                        >
                            <span class="visually-hidden">{{#str}}opendrawerindex, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                        </button>
                    </div>
                {{/courseindex}}
                {{#hasblocks}}
                    <div class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                        <button
                            class="btn btn-icon icon-size-3"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_boost-drawers-blocks"
                            data-bs-toggle="tooltip"
                            data-bs-placement="right"
                            title="{{#str}}opendrawerblocks, core{{/str}}"
                        >
                            <span class="visually-hidden">{{#str}}opendrawerblocks, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                        </button>
                    </div>
                {{/hasblocks}}
            </div>
            {{/hidenavbar}}
            {{> theme_boost_union/javascriptdisabledhint }}
            {{> theme_boost_union/infobannersbelow }}
            {{{ output.course_content_header_notifications }}}
            {{#regions.contentupper.hasblocks}}
                <section id="theme-block-region-content-upper" class="theme-block-region" aria-label="{{#str}}blocks{{/str}}">
                    {{{ regions.contentupper.addblockbutton }}}
                    {{{ regions.contentupper.regionhtml }}}
                </section>
            {{/regions.contentupper.hasblocks}}
            <div id="page-content" class="pb-3 d-print-block">
                <div id="region-main-box">
                    {{#hasregionmainsettingsmenu}}
                    <div id="region-main-settings-menu" class="d-print-none">
                        <div> {{{ regionmainsettingsmenu }}} </div>
                    </div>
                    {{/hasregionmainsettingsmenu}}
                    <div id="region-main">

                        {{#hasregionmainsettingsmenu}}
                            <div class="region_main_settings_menu_proxy"></div>
                        {{/hasregionmainsettingsmenu}}
                        {{{ output.course_content_header_coursecontent }}}
                        {{#headercontent}}
                            {{> core/activity_header }}
                        {{/headercontent}}
                        {{#overflow}}
                            <div class="container-fluid tertiary-navigation">
                                <div class="navitem">
                                    {{> core/tertiary_navigation_selector}}
                                </div>
                            </div>
                        {{/overflow}}
                        {{{courserelatedhints}}}
                        {{#sliderpositionbeforebefore}}
                            {{> theme_boost_union/slider }}
                        {{/sliderpositionbeforebefore}}
                        {{#advtilespositionbefore}}
                            {{> theme_boost_union/advertisementtiles }}
                        {{/advtilespositionbefore}}
                        {{#sliderpositionbeforeafter}}
                            {{> theme_boost_union/slider }}
                        {{/sliderpositionbeforeafter}}
                        {{{ landinghtml }}}
                        {{{ output.main_content }}}
                        {{{ output.activity_navigation }}}
                        {{{ output.course_content_footer }}}
                        {{#sliderpositionafterbefore}}
                            {{> theme_boost_union/slider }}
                        {{/sliderpositionafterbefore}}
                        {{#advtilespositionafter}}
                            {{> theme_boost_union/advertisementtiles }}
                        {{/advtilespositionafter}}
                        {{#sliderpositionafterafter}}
                            {{> theme_boost_union/slider }}
                        {{/sliderpositionafterafter}}

                    </div>
                </div>
            </div>
            {{#regions.contentlower.hasblocks}}
                <section id="theme-block-region-content-lower" class="theme-block-region" aria-label="{{#str}}blocks{{/str}}">
                    {{{ regions.contentlower.addblockbutton }}}
                    {{{ regions.contentlower.regionhtml }}}
                </section>
            {{/regions.contentlower.hasblocks}}
        </div>

        {{#regions.outsideright.hasblocks}}
            <section id="theme-block-region-outside-right" class="theme-block-region {{#blockregionsdata.outsideregions.verticaloffset}}invisible{{/blockregionsdata.outsideregions.verticaloffset}}" aria-label="{{#str}}blocks{{/str}}">
                {{#blockregionsdata.outsideregions.verticaloffset}}<div class="outside-region-alignmentspacer"></div>{{/blockregionsdata.outsideregions.verticaloffset}}
                {{{ regions.outsideright.addblockbutton }}}
                {{{ regions.outsideright.regionhtml }}}
            </section>
        {{/regions.outsideright.hasblocks}}
        </div>

        {{#regions.outsidebottom.hasblocks}}
            <section id="theme-block-region-outside-bottom" class="theme-block-region {{{outsidebottomwidth}}}" aria-label="{{#str}}blocks{{/str}}">
                {{{ regions.outsidebottom.addblockbutton }}}
                {{{ regions.outsidebottom.regionhtml }}}
            </section>
        {{/regions.outsidebottom.hasblocks}}

        {{#regions.footer.hasblocks}}
            <div id="theme-block-region-footer" class="{{{footerwidth}}}">
                <div class="row">
                     {{#regions.footerleft.hasblocks}}
                        <section id="theme-block-region-footer-left" class="theme-block-region {{regions.footer.class}}" aria-label="{{#str}}blocks{{/str}}">
                            {{{ regions.footerleft.addblockbutton }}}
                            {{{ regions.footerleft.regionhtml }}}
                        </section>
                    {{/regions.footerleft.hasblocks}}
                    {{#regions.footercenter.hasblocks}}
                        <section id="theme-block-region-footer-center" class="theme-block-region {{regions.footer.class}}" aria-label="{{#str}}blocks{{/str}}">
                            {{{ regions.footercenter.addblockbutton }}}
                            {{{ regions.footercenter.regionhtml }}}
                        </section>
                    {{/regions.footercenter.hasblocks}}
                    {{#regions.footerright.hasblocks}}
                        <section id="theme-block-region-footer-right" class="theme-block-region {{regions.footer.class}}" aria-label="{{#str}}blocks{{/str}}">
                            {{{ regions.footerright.addblockbutton }}}
                            {{{ regions.footerright.regionhtml }}}
                        </section>
                    {{/regions.footerright.hasblocks}}
                </div>
            </div>
        {{/regions.footer.hasblocks}}

        {{{ output.standard_after_main_region_html }}}
        {{> theme_boost/footer }}
        {{> theme_boost_union/footnote }}
    </div>
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer'{{#regions.offcanvas.hasblocks}},'theme_boost_union/offcanvas'{{/regions.offcanvas.hasblocks}}{{#includesmartmenu}}, 'theme_boost_union/smartmenu'{{/includesmartmenu}}{{#includestarredcacheinvalidation}}, 'theme_boost_union/smartmenu_starred_cacheinvalidation'{{/includestarredcacheinvalidation}}{{#blockregionsdata.includeblockregionsamd}}, 'theme_boost_union/blockregions'{{/blockregionsdata.includeblockregionsamd}}], function(Loader, Drawer{{#regions.offcanvas.hasblocks}},OffCanvas{{/regions.offcanvas.hasblocks}}{{#includesmartmenu}}, SmartMenu{{/includesmartmenu}}{{#includestarredcacheinvalidation}}, SmartMenuStarredCacheInvalidation{{/includestarredcacheinvalidation}}{{#blockregionsdata.includeblockregionsamd}}, BlockRegions{{/blockregionsdata.includeblockregionsamd}}) {
    Drawer.init();
    M.util.js_complete('theme_boost/loader');
    {{! All init method calls are placed on one line to avoid a ESLint warning about too many empty lines, see Github issue #1107. }}
    {{#regions.offcanvas.hasblocks}}OffCanvas.init();{{/regions.offcanvas.hasblocks}}{{#includesmartmenu}}SmartMenu.init();{{/includesmartmenu}}{{#includestarredcacheinvalidation}}SmartMenuStarredCacheInvalidation.init();{{/includestarredcacheinvalidation}}{{#blockregionsdata.outsideregions.verticaloffset}}BlockRegions.OutsideRegionsVerticalAlignment();{{/blockregionsdata.outsideregions.verticaloffset}}
});
{{/js}}
