# --- Local dev (npm run dev) vs. Docker Compose on the VPS ---
# The values below work for local dev against `docker compose up db storage` only.
# For a full VPS deploy, see the DOMAIN/POSTGRES_* section further down.

# Postgres. For local dev (npm run dev), "localhost" is correct — note the
# port is 3749, not Postgres's default 5432, since docker-compose.yml
# publishes `db` on host port 3749 (see the compose file's port comments for
# why services shifted to a 3748+n range). When this .env is used by
# docker-compose.yml on the VPS, change the host to `db` — the service name
# on the compose network — since "localhost" inside the `web`/`migrate`
# containers refers to the container itself, not the db container.
DATABASE_URL="postgresql://postgres:postgres@localhost:3749/erasight_lms"

# Auth (self-hosted, via next-auth's Credentials provider — email + password,
# no third-party identity provider). Signs the session JWT; treat like a
# password. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Sends invitation emails through your personal Gmail over SMTP.
# GMAIL_APP_PASSWORD is a 16-character Google App Password, NOT your regular
# Gmail password — requires 2-Step Verification enabled on the account.
# Generate one at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The very first ADMIN account. On first boot (only if the User table is
# still empty), scripts/bootstrap-admin.mjs creates this account so there's
# someone able to sign in and invite everyone else. After that, promote or
# invite further admins from the app itself — these three vars are only
# consulted while no users exist yet.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="Admin"

# S3-compatible object storage — self-hosted MinIO, kept fully private
# (no public domain, no Caddy route, no host port in docker-compose.yml).
# Uploads/downloads are relayed through the app itself: PUT /api/uploads and
# GET /api/files/[...key] (see lib/s3.ts). Because of this, S3_ENDPOINT is
# ONLY ever used server-side — unlike a presigned-URL setup, it does not need
# to be reachable by the browser.
# - VPS (docker-compose.yml): the internal service name, e.g. http://storage:9000
# - Local dev (npm run dev, outside Docker): `storage` has no host port by
#   default, so `npm run dev` can't reach it as-is. Either add a temporary
#   `docker-compose.override.yml` re-exposing "3750:9000" while developing
#   locally, or just run the full stack with `docker compose up` and hit the
#   app at localhost:3748 instead of `npm run dev`.
S3_ENDPOINT="http://storage:9000"
S3_REGION="us-east-1"
S3_BUCKET="erasight-lms"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- VPS / docker-compose.yml only ---

# Public domain Caddy issues a Let's Encrypt cert for and routes to `web`.
# Point its DNS A record at the VPS before `up`.
DOMAIN=lms.example.com
# For local Caddy testing without a real domain/DNS, use "localhost" and
# Caddy will serve HTTP instead of provisioning a certificate.

# Credentials for the `db` container itself (docker-compose.yml only — the
# app connects using the DATABASE_URL above, which must use the same values).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=erasight_lms

# Keeps Server Function closures decryptable across image rebuilds/redeploys.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
