generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MaterialType {
  VIDEO
  DOCUMENT
  LINK
  TEXT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  name         String
  passwordHash String
  role         Role   @default(STUDENT)

  enrollments        Enrollment[]
  instructingClasses Class[]      @relation("ClassInstructor")
  createdCourses     Course[]     @relation("CourseCreatedBy")
  sentInvitations    Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An admin-issued invite: sets the email + role in advance, sent via email
// with a link to /invite/[token]. Accepting it creates the User.
model Invitation {
  id          String    @id @default(uuid())
  email       String
  name        String    @default("")
  role        Role
  token       String    @unique
  invitedById String
  // The invite LINK's own expiry (7 days) — unrelated to how long a granted
  // class stays accessible after acceptance; see InvitationClassGrant.
  expiresAt   DateTime
  acceptedAt  DateTime?

  invitedBy   User                    @relation(fields: [invitedById], references: [id])
  classGrants InvitationClassGrant[]

  createdAt DateTime @default(now())

  @@index([email])
  @@index([invitedById])
}

// One row per Class an invitation grants access to, carrying the per-class
// access expiry as a template — only read once, at acceptInvitation time, to
// seed the resulting Enrollment.accessExpiresAt (the real source of truth).
model InvitationClassGrant {
  id              String    @id @default(uuid())
  invitationId    String
  classId         String
  accessExpiresAt DateTime?

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([invitationId, classId])
  @@index([invitationId])
  @@index([classId])
}

model Course {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  coverImage  String?
  status      CourseStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("CourseCreatedBy", fields: [createdById], references: [id])

  modules CourseModule[]
  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
}

model CourseModule {
  id       String @id @default(uuid())
  courseId String
  title    String
  order    Int

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model Session {
  id          String  @id @default(uuid())
  moduleId    String
  title       String
  description String? @db.Text
  order       Int

  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials Material[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model Material {
  id        String       @id @default(uuid())
  sessionId String
  type      MaterialType
  title     String
  url       String?      @db.Text // external link (LINK type only)
  content   String?      @db.Text // inline text body (TEXT type only)
  fileKey   String?      @unique // S3/MinIO object key (VIDEO/DOCUMENT types only)
  fileType  String?
  fileSize  Int?
  order     Int          @default(0)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

// A running cohort / offering of a Course, taught by an instructor, with an enrolled roster.
model Class {
  id           String    @id @default(uuid())
  courseId     String
  name         String
  startDate    DateTime?
  endDate      DateTime?
  instructorId String?

  course           Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor       User?                   @relation("ClassInstructor", fields: [instructorId], references: [id])
  enrollments      Enrollment[]
  invitationGrants InvitationClassGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([instructorId])
}

model Enrollment {
  id              String           @id @default(uuid())
  classId         String
  studentId       String
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime         @default(now())
  // After this date, the student loses access to this class's materials.
  // Null = open-ended access (no expiration).
  accessExpiresAt DateTime?

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
}

