{{!
    @template theme_erasight/hero

    Front-page hero banner — redesigned per Sep 2026 brief.
    Single column, left-aligned on mobile, centered on desktop.
    Background: real photograph with dark overlay.
    One primary CTA button (orange), one text link below.
    No stats row (removed: brief says no fabricated numbers).

    Context: headline, tagline, ctaprimaryurl, ctaprimarylabel,
    ctasecondaryurl, ctasecondarylabel, heroimage (URL to background).
}}
<div class="erasight-hero">
    <div class="erasight-hero-inner">
        <h1 class="erasight-hero-title">{{{headline}}}</h1>
        <p class="erasight-hero-tagline">{{{tagline}}}</p>
        <div class="erasight-hero-cta">
            <a class="erasight-btn erasight-btn-primary erasight-btn-lg" href="{{ctaprimaryurl}}">{{ctaprimarylabel}}</a>
        </div>
        {{#ctasecondaryurl}}
        <a class="erasight-hero-link" href="{{ctasecondaryurl}}">{{ctasecondarylabel}}</a>
        {{/ctasecondaryurl}}
    </div>
</div>
