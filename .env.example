# --- Moodle deployment via Docker Compose on the VPS ---
# Replaces the Next.js app's env vars that no longer apply (AUTH_SECRET,
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY, DATABASE_URL, S3_*) — reuses everything
# else that still means the same thing (Postgres creds, the public URL, the
# Gmail SMTP credentials, the bootstrap-admin identity).
#
# Public access is via Cloudflare Tunnel (cloudflared), run separately from
# this compose stack — there's no reverse proxy here. cloudflared's ingress
# already points at http://localhost:5895 (unchanged from before — see the
# `moodle` service in docker-compose.yml); the VPS needs no inbound port
# open publicly.

# Postgres — same instance as before, reused as-is. Moodle's tables live in
# this same database under the `mdl_` prefix, so no new database/credentials
# were needed to add it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=erasight_lms

# The public URL this is served at — Moodle bakes this into every generated
# link, so it must match whatever hostname actually reaches it.
NEXT_PUBLIC_APP_URL="https://lms.example.com"

# Sends Moodle's outgoing mail (notifications, password resets, and the
# Invitation plugin's invite emails once installed) through your personal
# Gmail over SMTP — configured automatically on install
# (docker/install-database.sh calls admin/cli/cfg.php with these).
# GMAIL_APP_PASSWORD is a 16-character Google App Password, NOT your regular
# Gmail password — requires 2-Step Verification enabled on the account.
# Generate one at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The Moodle admin account, created once on first install
# (docker/install-database.sh) — safe to leave as-is after that; promote or
# invite further admins from within Moodle itself from then on.
MOODLE_ADMIN_USER=admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

MOODLE_SITE_FULLNAME="Erasight LMS"
MOODLE_SITE_SHORTNAME="ErasightLMS"
