{{!
    @template theme_erasight/sitefooter

    Sitewide footer band, injected on every page via
    before_standard_footer_html_generation (see
    classes/hook_callbacks.php) rather than folded into
    layout/frontpage.php, since that layout is only used on the front
    page and every other page falls back to Boost Union's own unforked
    drawers.php. New, theme-owned markup — not a core override.

    Context: tagline, linksheading, links (array of label/url).
    socialheading, hassocial boolean, socials (array of name/url plus
    one of iconlinkedin/icontwitter/iconfacebook set true, selecting
    which inline SVG glyph to draw — Mustache has no string-equality
    check, so this is precomputed in PHP rather than compared here).
    copyright.

    NOTE: never write two closing-brace characters next to each other
    anywhere in this comment block, quoted or not, per this theme's
    permanent house rule on comment self-termination.
}}
<div class="erasight-sitefooter">
    <div class="erasight-sitefooter-inner">
        <div class="erasight-sitefooter-brand">
            <div class="erasight-sitefooter-name">Erasight LMS</div>
            <p>{{tagline}}</p>
        </div>

        <div class="erasight-sitefooter-links">
            <div class="erasight-sitefooter-heading">{{linksheading}}</div>
            <ul>
                {{#links}}
                <li><a href="{{url}}">{{label}}</a></li>
                {{/links}}
            </ul>
        </div>

        {{#hassocial}}
        <div class="erasight-sitefooter-social">
            <div class="erasight-sitefooter-heading">{{socialheading}}</div>
            <div class="erasight-sitefooter-icons">
                {{#socials}}
                <a href="{{url}}" class="erasight-social-icon" aria-label="{{name}}" rel="noopener">
                    {{#iconlinkedin}}
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.7c0-1.36-.02-3.1-1.9-3.1-1.9 0-2.2 1.47-2.2 3v5.8h-4V9z"/></svg>
                    {{/iconlinkedin}}
                    {{#icontwitter}}
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-7.3 8.3L23 22h-6.9l-5.4-6.7L4.5 22H1.4l7.8-8.9L1 2h7.1l4.9 6.2L18.9 2zm-1.2 18h1.9L7.4 4H5.4l12.3 16z"/></svg>
                    {{/icontwitter}}
                    {{#iconfacebook}}
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg>
                    {{/iconfacebook}}
                </a>
                {{/socials}}
            </div>
        </div>
        {{/hassocial}}
    </div>

    <div class="erasight-sitefooter-bottom">
        <span>{{copyright}}</span>
    </div>
</div>
