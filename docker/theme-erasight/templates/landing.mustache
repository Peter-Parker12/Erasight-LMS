{{!
    @template theme_erasight/landing

    Front-page landing sections below the hero. Redesigned per Sep 2026 brief.
    Sections in order:
      S2 - Two course cards (AI Marketing + English)
      S3 - How Erasight teaches (3 columns)
      S5 - Instructors
      S6 - FAQ accordion
      S7 - Closing CTA band

    Removed entirely: course grid (6 cards), testimonials, scenarios,
    team pricing, segments — per brief instructions.

    Context variables documented per section below.
    NOTE: never write two closing-brace characters next to each other
    anywhere in this comment block — Mustache comment termination rule.
}}
<div class="erasight-landing">

    {{! ── S2: Two Course Cards ───────────────────────────────── }}
    {{#hascourses}}
    <section class="erasight-section" id="khoa-hoc">
        <div class="erasight-courses-duo">
            {{#courses}}
            <div class="erasight-course-card">
                <div class="erasight-course-img" style='background-image: url("{{{image}}}");'></div>
                <div class="erasight-course-body">
                    <span class="erasight-course-badge {{badgeclass}}">{{badge}}</span>
                    <h3 class="erasight-course-name">{{name}}</h3>
                    <p class="erasight-course-result">{{result}}</p>
                    <ul class="erasight-course-bullets">
                        {{#bullets}}
                        <li>{{text}}</li>
                        {{/bullets}}
                    </ul>
                    <div class="erasight-course-footer">
                        <div class="erasight-course-price">{{price}}</div>
                        {{#enrolldate}}
                        <div class="erasight-course-date">{{enrolldate}}</div>
                        {{/enrolldate}}
                        <a class="erasight-btn erasight-btn-primary" href="{{detailurl}}">{{cta}}</a>
                    </div>
                </div>
            </div>
            {{/courses}}
        </div>
    </section>
    {{/hascourses}}

    {{! ── S3: How Erasight Teaches ───────────────────────────── }}
    {{#hasmethods}}
    <section class="erasight-section" id="cach-day">
        <h2 class="erasight-section-title">{{methodtitle}}</h2>
        <div class="erasight-methods">
            {{#methods}}
            <div class="erasight-method-card">
                <div class="erasight-method-img" style='background-image: url("{{{image}}}");'>
                    <span class="erasight-method-badge">{{step}}</span>
                </div>
                <div class="erasight-method-body">
                    <h4>{{title}}</h4>
                    <p>{{body}}</p>
                </div>
            </div>
            {{/methods}}
        </div>
    </section>
    {{/hasmethods}}

    {{! ── S5: Instructors ────────────────────────────────────── }}
    {{#hasinstructors}}
    <section class="erasight-section" id="giang-vien">
        <h2 class="erasight-section-title">{{instructorstitle}}</h2>
        <div class="erasight-instructors">
            {{#instructors}}
            <div class="erasight-instructor">
                <img class="erasight-instructor-photo" src="{{{photo}}}" alt="{{name}}" width="120" height="120" loading="lazy">
                <div class="erasight-instructor-info">
                    <h4>{{name}}</h4>
                    <span class="erasight-instructor-role">{{role}}</span>
                    <p>{{bio}}</p>
                </div>
            </div>
            {{/instructors}}
        </div>
    </section>
    {{/hasinstructors}}

    {{! ── S6: FAQ Accordion ──────────────────────────────────── }}
    {{#hasfaq}}
    <section class="erasight-section" id="hoi-dap">
        <h2 class="erasight-section-title">{{faqtitle}}</h2>
        <div class="erasight-faq">
            {{#faqs}}
            <details class="erasight-faq-item" {{#first}}open{{/first}}>
                <summary>{{question}}</summary>
                <div class="erasight-faq-answer">{{answer}}</div>
            </details>
            {{/faqs}}
        </div>
    </section>
    {{/hasfaq}}

    {{! ── S7: Closing CTA Band ───────────────────────────────── }}
    <section class="erasight-closing">
        <p class="erasight-closing-text">{{closingheadline}}</p>
        <a class="erasight-btn erasight-btn-primary erasight-btn-lg" href="{{closingctaurl}}">{{closingctalabel}}</a>
    </section>
</div>
